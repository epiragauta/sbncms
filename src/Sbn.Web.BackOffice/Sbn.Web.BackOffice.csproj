<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Sbn.Cms.Web.BackOffice</RootNamespace>
        <PackageId>Sbn.Cms.Web.BackOffice</PackageId>
        <Title>Sbn CMS Back Office</Title>
        <Description>Contains the Back Office assembly needed to run the back office of Sbn Cms. This package only contains the assembly, and can be used for package development. Use the template in the Sbn.Templates package to setup Sbn</Description>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\Sbn.Web.BackOffice.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>

      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
      <PackageReference Include="Serilog.AspNetCore" Version="4.1.0" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Sbn.Tests.UnitTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Sbn.Tests.Integration</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sbn.Core\Sbn.Core.csproj" />
        <ProjectReference Include="..\Sbn.Examine.Lucene\Sbn.Examine.Lucene.csproj" />
        <ProjectReference Include="..\Sbn.Infrastructure\Sbn.Infrastructure.csproj" />
        <ProjectReference Include="..\Sbn.Web.Common\Sbn.Web.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="EmbeddedResources\**\*" />
    </ItemGroup>
</Project>

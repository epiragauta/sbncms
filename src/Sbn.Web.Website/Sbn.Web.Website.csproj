<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Sbn.Cms.Web.Website</RootNamespace>
        <PackageId>Sbn.Cms.Web.Website</PackageId>
        <Title>Sbn CMS Website</Title>
        <Description>Contains the Website assembly needed to run Sbn Cms (Front office). This package only contains the assembly, and can be used for package development. Use the template in the Sbn.Templates package to setup Sbn</Description>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\Sbn.Web.Website.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Sbn.Web.Website.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sbn.Core\Sbn.Core.csproj" />
        <ProjectReference Include="..\Sbn.Infrastructure\Sbn.Infrastructure.csproj" />
        <ProjectReference Include="..\Sbn.Web.Common\Sbn.Web.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Sbn.Tests.UnitTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Sbn.Tests.Integration</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>

    <div class="top-content">
        <div class="container-fluid">
            <div id="carousel-casos" class="carousel slide" data-ride="carousel" data-interval="false">
                <div class="carousel-inner-mc row w-100 mx-auto" role="listbox">
                    @{
                        var startNodeCases = Sbn.Content(1090);
                        var cases = startNodeCases.Children.OrderBy(x => x.CreateDate).ToList();
                        var activeClss = "active";
                        @foreach (ContentModels.CasoDeExito caso in cases){
                            <div class="carousel-item carousel-item-casos col-12 col-sm-6 col-md-4 col-lg-3 carousel-casos @activeClss" data-interval="false"><a href="/casos-de-exito/">
                                @if (@caso.Imagen != null && @caso.Imagen != null){
                                    <img src="@caso.Imagen.LocalCrops.Src" class="img-carousel-caso-exito img-fluid mx-auto d-block" alt="img-@caso.Nombre">
                                }
                                <div class="overlay">
                                    <span>
                                        <div class="card-body"> 
                                            <h5 class="card-title text-center">@caso.Nombre</h5>
                                            <div class="border border-carousel-slide title-separator-secondary-carousel"></div>
                                            <!-- <p class="card-text">@caso.Detalle</p> -->
                                        </div> 
                                    </span>
                                </div>
                            </a></div>
                            activeClss = "";
                        }
                    }
                 </div>

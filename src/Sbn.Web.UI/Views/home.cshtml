    <link rel="stylesheet" href="@Url.Content("~/css/sbn-diagram.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/libs/sweetalert2.min.css")" media="screen">
    
    <script type="text/javascript" src="@Url.Content("~/sbn/lib/jquery/jquery.min.js")"></script>
    <script class="u-script" type="text/javascript" src="@Url.Content("~/scripts/bootstrap.min.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/data-diagram.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/sbn-diagram.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/libs/sweetalert2.all.min.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/sbn.js")" defer=""></script>
    
    <script type="text/javascript">
        
        var welcome = "Plataforma con métodos y herramientas para la formulación, implementación y monitoreo " +
                    "de proyectos de soluciones basadas en naturaleza (SBN) para la conservación de " + 
                    "biodiversidad, cambio climático (adaptación y mitigación) y seguridad hídrica, como " +
                    "aporte al fortalecimiento de capacidades de Ecopetrol y otros socios estratégicos.";
        
        $(document).ready(function(){
            if (localStorage.getItem("sbnWelcome") == undefined){
                Swal.fire({
                    title: 'BIENVENIDO',
                    text: welcome,
                    confirmButtonText: "INGRESAR",
                    confirmButtonColor: "#0a3f0a",
                    buttonsStyling: false,
                }).then((result) =>{
                    if (result.isConfirmed) {
                        //Swal.fire('Saved!', '', 'success');
                        //return;
                        (async () => {
                            let html = `<div class="form-group row row-form-input">
                                            <label style="text-align: left;" class="col-sm-4 col-form-label">Nombre completo: *</label>
                                            <div class="col-sm-7">
                                                <input type="text" id="swal-input1" class="form-control input-lg" name="fullname_" value="">
                                            </div>
                                        </div>
                                        <div class="form-group row row-form-input">
                                            <label style="text-align: left;" class="col-sm-4 col-form-label">Sector: *</label>
                                            <div class="col-sm-7">
                                                <select class="form-control" id="sector-select">
                                                  <option>ONG</option>
                                                  <option>Investigación</option>
                                                  <option>Productivo</option>
                                                  <option>Otro</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row row-form-input">
                                            <label style="text-align: left;" class="col-sm-4 col-form-label">Organizacion: *</label>
                                            <div  class="col-sm-7">
                                                <input type="text" id="swal-input2" class="form-control input-lg" name="organizacion_" value="">
                                            </div>
                                        </div>
                                        <div class="form-group row row-form-input">
                                            <label style="text-align: left;" class="col-sm-4 col-form-label">Correo electrónico: *</label>
                                            <div  class="col-sm-7">
                                                <input type="text" id="swal-input2" class="form-control input-lg" name="email_" value="">
                                            </div>
                                        </div>`;    
                            const { value: formValues } = await Swal.fire({
                              title: 'Comparte tus datos con nosotros',
                              html: html,
                              focusConfirm: false,
                              showDenyButton: true,
                              confirmButtonText: "COMPARTIR DATOS",
                              denyButtonText: "AHORA NO",
                              width: 600,
                              preConfirm: () => {
                                return [
                                  document.getElementById('swal-input1').value,
                                  document.getElementById('swal-input2').value
                                ]
                              }
                            })
                            
                            if (formValues) {
                              Swal.fire("Gracias!")
                            }
                            
                            })()
                    }
                });
                localStorage.setItem("sbnWelcome", "true");
                //$("#ModalShareForm").modal('show');
            }
        })
    </script>

</head>


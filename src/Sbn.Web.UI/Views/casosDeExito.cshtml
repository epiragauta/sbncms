@using ContentModels = Sbn.Cms.Web.Common.PublishedModels;
@inherits Sbn.Cms.Web.Common.Views.SbnViewPage<ContentModels.CasosDeExito>
@{
	Layout = "master.cshtml";
}
<link rel="stylesheet" href="@Url.Content("~/css/sbn-casos-de-exito.css")" media="screen">
<script type="text/javascript" src="@Url.Content("~/scripts/sbn-casos-de-exito.js")"></script>

<div class="casos-de-exito-background-header">
    <div class="casos-de-exito-background-header-overcolor"></div>
</div>
<section class="section container w3-border w3-container w3-round-xlarge" style="padding:1rem 3rem;" >
    
    <div class="text-center casos-de-exito-header"><h2 style="color:#fff !important;">Casos de éxito</h2></div>
    
    <div class="row" style="margin-left: 4px;">
        <div class="col-md-4">
            <select class="custom-select mb-3" aria-label="Default select example">
              <option selected>Seleccione una opción</option>
              <option value="1">One</option>
              <option value="2">Two</option>
              <option value="3">Three</option>
            </select>
        </div>
    </div>

    <div class="row" style="margin-left: 20px;">
        <div class="input-group mb-3">
          <input type="text" class="form-control" placeholder="Buscar Casos de éxito" aria-label="Buscar Casos de éxito" aria-describedby="basic-addon1">
        </div>
    </div>
    
    <section class="section section-casos-de-exito">
        <div class="row row-casos-de-exito">
        @{
            var numberOfCases = 5; //Model.CasosAmostrar;
            var startNodeId = Model.Id;
            var startNode = Sbn.Content(startNodeId);
            if (startNode == null){
                  <div class="study-cases">
                      <h1>No hay casos de estudio en este momento, intente después.</h1>
                  </div>
                  return;
            }
            
            //Gets all study cases to calculate pages
            var cases = startNode.Children.OrderBy(x => x.CreateDate).ToList();
            var numOfCases = cases.Count;
            var columns = 3;
            int counter = 0;
            int numOfCasesByPage = 6;
            
            var pageCount = (int)Math.Ceiling((double)numOfCases / (double)numOfCasesByPage);
            //gets the page from the querystring and sets it to one if it is out of range
            
            var page = 1;
            
            if (!string.IsNullOrEmpty(Context.Request.Query["page"])){
                int.TryParse(Context.Request.Query["page"], out page);
                if (page <= 0 || page > pageCount){
                    page = 1;
                }
            }
            
            //Gets the cases for the current page
            var pagedCases = cases.Skip((page - 1) * numOfCasesByPage).Take(numOfCasesByPage).ToList();
        
        
            if (pagedCases.Count != null){
                @foreach (ContentModels.CasoDeExito caso in pagedCases){
                    if (counter != 0 && counter % columns == 0){
                        @:</div>
                        @:<div class="row row-casos-de-exito">
                    }
                    <div class="col-md-4">
                        <div class="active card-casos-de-exito">
                            <img src="@caso.Imagen.LocalCrops.Src" class="card-img-casos-de-exito" alt="img1">
                            <div class="overlay">
                                <span>
                                    <div class="card-body card-text-overlay">
                                        <h5 class="card-title text-center">@caso.Nombre</h5>
                                        <p class="card-text">@caso.Detalle</p>
                                    </div>
                                </span>
                                <div class="cart-download-icon"><i class="bi bi-download"></i></div>
                            </div>
                            <div class="card-title-main">
                                <h5 class="card-title text-center">@caso.Nombre</h5>
                            </div>
                        </div>
                    </div>
                    counter++;
                }
            }
        }
            
        </div>
        <div class="row" style="padding-top:25px;">
            <div class="col-md-12">
            @{        
                if (pageCount > 1){
                    <div class="pagination justify-content-center">
                        <ul>
                            @if (page > 1)
                            {
                                <li><a href="?page=@(page-1)">&lt</a></li>
                            }
                            @for (int p = 1; p < pageCount + 1; p++)
                            {
                                <li class="@(p == page ? "active" : string.Empty)">
                                    <a href="?page=@p">@p</a>
                                </li>
                            }
                            @if (page < pageCount)
                            {
                                <li><a href="?page=@(page+1)">&gt</a></li>
                            }
                        </ul>
                    </div>
                }
            }
            </div>
        </div>
    </section>
    
</section>
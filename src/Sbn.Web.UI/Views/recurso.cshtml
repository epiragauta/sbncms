@inherits Sbn.Cms.Web.Common.Views.SbnViewPage<ContentModels.Recurso>
@using ContentModels = Sbn.Cms.Web.Common.PublishedModels;
@{
	Layout = "master.cshtml";
}


<section class="section container w3-border w3-container w3-round-xlarge" >
    
    <section class="section">
        <div class="container">
            <h2>@Model.Nombre</h2>
            <div>@Model.Detalle</div>
            <h4>Documentos</h4>
            @foreach (var d in @Model.Documento){
                <a target="_blank" href="@d.Url">Ver documento</a>
            }
            
            <div>
            @{
            
                if (@Model.PalabrasClave.ToList().Count > 0){
                
                    <span class="label label-success">Palabras Clave: </span>
                    foreach (var p in @Model.PalabrasClave){
                        <span class="badge badge-success">@p</span>
                    }
                }
                
            }
            </div>
            <div class="blogpost-meta">
                <small class="blogpost-date">@Model.CreateDate.ToShortDateString()</small>
            </div>
        </div>
     </section>
</section>

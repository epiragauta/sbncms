@using Sbn.Cms.Web.Common.PublishedModels;
@inherits Sbn.Cms.Web.Common.Views.SbnViewPage<ContentModels.Sbn2>
@using ContentModels = Sbn.Cms.Web.Common.PublishedModels;
@using Sbn.Cms.Core.Models;
@using Sbn.Cms.Core.Services;
@using Sbn.Cms.Core.PropertyEditors;
@using System.Collections;
@using System.Reflection;
@using System.Collections.Generic;
@inject IDataTypeService DataTypeService;
@{
	Layout = "master.cshtml";
	var clsHeaderSbn = "show-header-sbn";

    if (!string.IsNullOrEmpty(Context.Request.Query["h"])){
        clsHeaderSbn = Context.Request.Query["h"] == "f" ? "hide-header-sbn" : "show-header-sbn";
    }
}
@section Scripts {
     <script type="text/javascript" src="@Url.Content("~/scripts/sbn-detalle.js")"></script>
}


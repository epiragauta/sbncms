<div class="container-fluid section-toolbox-2 parallax" style="padding-top: 1rem !important; margin-top: 2rem;padding-right: 0px;padding-left: 0px;">
    <div class="container" style="padding-top: 1rem !important;">
        <div class="toolbox-border">

                <div class="col-2 menu-vertical-tab d-md-block d-lg-none">
                    <div id="v-pills-tab" class="nav flex-column nav-pills" aria-orientation="vertical"  >
                        <a id="v-pills-home-tab" href="#v-pills-home" class="nav-link active text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-home" aria-selected="true"><i class="bi bi-house" style="font-size:30px "></i></a> 
                        <a id="v-pills-preparar-tab" href="#v-pills-preparar" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-preparar" aria-selected="false"><img src="/media/uoipkmrq/preparar-n.svg" alt="Actividad1" width="40" /></a> 
                        <a id="v-pills-formular-tab" href="#v-pills-formular" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-formular" aria-selected="false"><img src="/media/kf4p31rw/formular-n.svg" alt="Actividad1" width="40" /></a> 
                        <a id="v-pills-planificar-tab" href="#v-pills-planificar" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-planificar" aria-selected="false"><img src="/media/5paddioe/planificar-n.svg" alt="Actividad1" width="35" /></a> 
                        @if (@Model.PasosImplementacion != null){<a id="v-pills-implementar-tab" href="#v-pills-implementar" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-implementar" aria-selected="false"><img src="/media/llsld0xl/implementar-n.svg" alt="Actividad1" width="40" /></a>} 
                        <a id="v-pills-seguimiento-tab" href="#v-pills-seguimiento" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-seguimiento" aria-selected="false"><img src="/media/wc0mfti1/seguimiento-n.svg" alt="Actividad1" width="40" /></a>
                        <a id="v-pills-aprendizaje-tab" href="#v-pills-aprendizaje" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-aprendizaje" aria-selected="false"><img src="/media/izgfzxkk/aprendizaje-n.svg" alt="Actividad1" width="40" /></a> 
                        @if (@Model.CasosDeExito != null){<a id="v-pills-caso-exito-tab" href="#v-pills-caso-exito" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-caso-exito" aria-selected="false"><i class="bi bi-graph-up-arrow" style="font-size:30px"></i></a>} 
                        @if (@Model.Glosario != null){<a id="v-pills-glosario-tab" href="#v-pills-glosario" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-glosario" aria-selected="false"><i class="bi bi-list-ul" style="font-size:30px"></i></a>}
                        <a id="v-pills-hoja-de-ruta-tab" href="#v-pills-hoja-de-ruta" class="nav-link text-center sbn-nav-bar-responsive" data-toggle="pill" aria-controls="v-pills-hoja-de-ruta" aria-selected="false"><i class="bi bi-map" style="font-size:30px"></i></a>
                    </div>
                </div>
                <div class="col-10" style="background: #fff;padding-right: 25px !important;">
                    <div id="v-pills-tabContent" class="tab-content">
                        <div id="v-pills-home" class="tab-pane fade show active" aria-labelledby="v-pills-home-tab">
                            <div class="row">
                                <div class="col-md-9">
                                    <div class="text-center sbn-imagen-size">
                                        <img src="@Model.ImagenPortada.LocalCrops.Src" alt="@Model.Name" width="100%" height="100%"/>
                                    </div>
                                    <h5  style="text-align: center;"><strong>@Model.Nombre</strong></h5>
                                    <div class="row text-center">
                                        <div class="col-md-5"></div>
                                        <div class="col-md-2 green-line-separator"></div>
                                        <div class="col-md-5"></div>
                                    </div>
                                    <div class="sbn-text-container2">
                                        <p style="text-align: center;">@Model.Descripcion</p>
                                    </div>
                                    <br>
                                    <h5 style="text-align: center;"><strong>Objetivos</strong></h5>
                                    <div class="row text-center">
                                      <div class="col-md-5"></div>
                                      <div class="col-md-2 green-line-separator"></div>
                                      <div class="col-md-5"></div>
                                    </div>
                                    <div class="sbn-text-container2">
                                        <p style="text-align: center;">@Model.Objetivos</p>
                                    </div>
                                    <br>
                                    <h5 style="text-align: center;"><strong>Objetivos de Desarrollo Sostenible</strong></h5>
                                    <div class="row text-center">
                                      <div class="col-md-5"></div>
                                      <div class="col-md-2 green-line-separator" ></div>
                                      <div class="col-md-5"></div>
                                    </div>
                                  @{
                                      var listIdOds = new List<String>();
                                      var listODS = new List<String>();
                                      foreach (var goal in @Model.Ods){
                                          if (@goal.IndexOf("-") != -1){
                                              listIdOds.Add(@goal.Split("-")[0]);
                                          }
                                      }
                                  }
                                  @{
                                      var x = 1;
                                      var classImg = "";
                                      var showODS = true;
                                      int numMd = listIdOds.Count <= 6 ? 6-listIdOds.Count : listIdOds.Count <= 12 ? 12-listIdOds.Count : listIdOds.Count <= 18 ? 18-listIdOds.Count : listIdOds.Count ;
                                      int countEnableODS = listIdOds.Count;
                                      
                                      <div class="panel-ods sdg">
                                      
                                      @for(var i = 0; i < 3; i++){
                                          <div class="row">
                                              @for(var j = 0; j < 6; j++){
                                                  var y = "0" + x.ToString();
                                                  y = y.Substring(y.Length-2,2);
                                                  showODS = true;
                                                  var src = "/media/assets/img/ods/s-web-goal-" + y + ".png";
                                                  if (!listIdOds.Contains(x.ToString())){
                                                      showODS = false;
                                                  }else{
                                                    listODS.Add(src);
                                                  }
                                                  x++;
                                              }
                                          </div>
                                      }
                                        <div class="row">
                                        @for(var i = 0; i < listIdOds.Count; i++){
                                          <div class="col-md-2 p-2 text-center sbn-desafio-img">
                                              <img width="100%" height="100%" src="@listODS[i]" alt="SDG icon" >
                                          </div>
                                        }
                                        
                                        @if(numMd > 0){
                                          var md=numMd+1;
                                          <div class="col-md-@md p-2"></div>
                                        }
                                        
                                        
                                        </div>
                                      </div>
                                  }
                                <div class="row text-center" style="padding-top: 1rem; padding-bottom: 1rem; background: #e6e6e6;">
                                    <div class="col-md-12">
                                        <p>Si usted desea conocer más sobre los ODS visite el siguiente enlace:</p>
                                        <a href="https://www.un.org/sustainabledevelopment/es/objetivos-de-desarrollo-sostenible/" target="_blank"> <button class="btn btn-sbn-white">ir a enlace</button></a>
                                    </div>
                                </div>
                                </div>
                                <div class="col-md-3 vline-right-panel" style="margin-bottom:0;">
                                    <div class="text-center toolbox-right-panel"><strong>Aproximación a los servicios ecosistémicos</strong>
                                        <div class="calification-right-panel">
                                            @{
                                                var excludeProps = new string[]{"ContentType", "Key", "Properties"};
                                                Dictionary<string, string> list = new Dictionary<string, string>();
                                                list.Add("AlmacenamientoCarbono","Almacenamiento de carbono");
                                                list.Add("BellezaEscenica","Belleza Escenica");
                                                list.Add("BienestarHumano","Bienestar humano");
                                                list.Add("CalidadHabitat","Calidad de hábitat");
                                                list.Add("CiclajeDeNutrientesYfertilidadDelSuelo","Ciclaje de Nutrientes y fertilidad del suelo");
                                                list.Add("ControlDeInundaciones","Control de inundaciones");
                                                list.Add("ControlDeLaErosion","Control de la erosión");
                                                list.Add("DiversidadDeEspeciesDeFaunaYflora","Diversidad de especies de fauna y flora");
                                                list.Add("IntercambioGenetico","Intercambio genético");
                                                list.Add("Polinizacion","Polinización");
                                                list.Add("PracticasCulturales","Prácticas culturales");
                                                list.Add("ProductosMedicinales","Productos medicinales");
                                                list.Add("ProvisionAgua","Provisión de agua");
                                                list.Add("ProvisionAlimentos","Provisión de alimentos");
                                                list.Add("ProvisionDeHabitat","Provisión de Habitat");
                                                list.Add("ProvisionDeMadera","Provisión de madera");
                                                list.Add("ProvisionDeProductosNoMaderables","Provision de productos no maderables");
                                                list.Add("PurificacionDelAgua","Purificación del agua");
                                                list.Add("PurificacionDelAire","Purificación del aire");
                                                list.Add("RecreacionTurismo","Recreación y Turismo");
                                                list.Add("RegulacionDelClima","Regulacion del clima");
                                                list.Add("RegulacionHidrica","Regulacion hídrica");
                                                list.Add("2","green");
                                                list.Add("1","orange");
                                                //Dictionary<int, string> serviciosOrdenados = new Dictionary<int, string>();
                                                foreach (var prop in @Model.Servicios.GetType().GetProperties()){
                                                    var value = @prop.GetValue(@Model.Servicios).ToString();
                                                    if (Array.IndexOf(excludeProps, prop.Name) == -1 ) {
                                                        if (value != "0"){
                                                            <div class="calification-check"><img src="/media/assets/img/@list[@value]-checkbox.png" alt="calificacion ok" width="36" />
                                                                <p>@list[@prop.Name]</p>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            }
                                            <div><br><br></div>
                                            
                                            @{
                                                var startNodeSbNs = Sbn.Content(1414); // 1414 corresponde al ID de los Videos
                                                var videos = startNodeSbNs.Children.OrderBy(x => x.CreateDate).ToList();
                                                @foreach(ContentModels.VideoCapacitacion videoc in videos){
                                                    if(@Model.VideoEntrenamiento != null && @videoc.Id == @Model.VideoEntrenamiento.Id){
                                               
                                                        <div>
                                                            @if (@Model.VideoEntrenamiento != null){
                                                                <div class="text-center"><strong>Video explicativo</strong></div>
                                                                <div class="row text-center">
                                                                    <div class="col-md-5"></div>
                                                                    <div class="col-md-2 green-line-separator"></div>
                                                                    <div class="col-md-5"></div>
                                                                </div>
                                                                <button type="button" class="btn calification-check" data-toggle="modal" data-target="#myModal"><img src="/media/assets/img/boton-play-sbn.png" alt="calificacion play" width="80" /></button>
                                                                <!-- CÓDIGO DE VENTANA MODAL -->
                                                                <div class="modal" id="myModal">
                                                                    <div class="modal-dialog" style="height: 100%;">
                                                                        <div class="modal-content" style="height: 50%;">
                                                                            <div class="modal-body" id="VideoSbn">
                                                                                <iframe width="100%" height="100%" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" id="videoSbn" 
                                                                                allowfullscreen sandbox="allow-presentation, allow-same-origin , allow-scripts" controls="controls" src="@videoc.URL.Url" name="media1"> </iframe>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            
                                                        </div>
                                                    }
                                                }
                                            }
                                            
                                        </div>                                        
                                    </div>
                                </div>
                            </div>
                            
                            <!-- TIPS -->
                                <!-- Modal -->
                                    @if (@Model.TipsInicio != null && @Model.TipsInicio.Count() > 0){
                                    <a class="float-button" data-toggle="modal" data-target="#modalInicio" style="padding-top: 0.75rem;"><i class="bi bi-bookmark-check" style="font-size: 1.5rem;"></i></a>
                                    <div class="modal fade" id="modalInicio" tabindex="-1" aria-labelledby="sbn-tips" aria-hidden="true">
                                        <div class="modal-dialog sbn-tips" >
                                            <div class="modal-content">
                                                <div class="modal-header" style="background-color: #bad405;">
                                                    <h4 class="modal-title" id="sbn-tips"><strong>Tenga en cuenta:</strong></h4>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                            <div class="modal-body">
                                                @foreach(var tip in @Model.TipsInicio){
                                                    <div>
                                                        <p class="bold-text-sbn" style="font-size: 17px;"><strong>@tip.Titulo</strong></p>
                                                        <p style="color:#0a3f0a; font-size: 15px;">@tip.Contenido</p>
                                                    </div>
                                                    if (@tip.URL != null){
                                                    <div>
                                                        <a style="color:#0a3f0a; margin-bottom: 1rem;" href="@tip.URL.Url" target="_blank">ver más</a>
                                                        <p></p>
                                                        <!-- <p>Orden: @tip.OrdenDePresentacion</p> -->
                                                    </div>
                                                    }
                                                } 
                                            </div>
                                        </div>
                                      </div>
                                    </div>
                                    }
                        </div>
                        
                                                                        <!-- PREPARACIÓN -->
                        
                        <div id="v-pills-preparar" class="tab-pane fade" aria-labelledby="v-pills-preparar-tab">
                            <h5 class="text-center tittle-sbn2">Pasos y herramientas sugeridos en la etapa de preparación de esta SbN</h5>
                            <div class="row text-center ">
                                <div class="col-md-5"></div>
                                <div class="col-md-2 green-line-separator "></div>
                                <div class="col-md-5"></div>
                            </div>                                
                          <!-- accordion -->
                          @{
                              int counter = 1;
                              <div class="accordion" id="accordionSbn">
                                  @foreach (var paso in @Model.Paso){
                                      <div>
                                          <div class="card-header" id="heading_@counter" style="padding: unset !important;">
                                              <h2 class="mb-0" >
                                              <button class="btn btn-block text-left bold-text-sbn" type="button" data-toggle="collapse" data-target="#accordion_@counter" aria-expanded="false" aria-controls="accordion_@counter" style="box-shadow: 0 0 0 0;">
                                                  <img class="sbn-img-resource" src="/media/5r2ffs2p/preparar-b.svg" alt="Actividad1" width="60" height: "4rem" />
                                                  <a style="font-size:18px;">@paso.Nombre<a>
                                                  <a class="btn btn-sbn-tools-3 btn-sbn-tools-width" style="float:right;margin-top: 0.5rem;padding-top: 12px;">Ver más</a>
                                              </button>
                                              </h2>
                                          </div>
                                          <div id="accordion_@counter" class="collapse" aria-labelledby="heading_@counter" data-parent="#accordionSbn">
                                              <div class="card-body normal-text-sbn"style="padding-top: 0;">
                                                <a style="margin-bottom: 1rem;"> @paso.Descripcion</a>
                                                <div  style="overflow-x:auto;">

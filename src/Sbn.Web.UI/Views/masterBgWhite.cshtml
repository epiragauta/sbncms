@using Sbn.Cms.Web.Common.PublishedModels;
@inherits Sbn.Cms.Web.Common.Views.SbnViewPage
@{
	Layout = null;
}
<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>@Model.Name</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="@Url.Content("~/css/bootstrap.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/css/home.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/css/sbn.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/css/libs/sweetalert2.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/css/libs/smart_wizard_all.min.css")" media="screen">
    
    <script type="text/javascript" src="@Url.Content("~/sbn/lib/jquery/jquery.min.js")"></script>
    <script class="u-script" type="text/javascript" src="@Url.Content("~/scripts/bootstrap.min.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/libs/sweetalert2.all.min.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/libs/jquery.smartWizard.min.js")" defer=""></script>
    <script type="text/javascript" src="@Url.Content("~/scripts/sbn.js")" defer=""></script>
    
    @RenderSection("Header", required: false)
</head>

<body class="bg-white">
    <header class="u-clearfix u-custom-color-3 u-header u-header" id="sec-ead9">
        @Html.Partial("~/Views/Partials/Navigation/sbnHeader.cshtml")
    </header>
    
    <main>
        @RenderBody()
    </main>
    
    <div style="padding-top: 2rem;background: #fff;">
         @Html.Partial("~/Views/Partials/Navigation/sbnFooter.cshtml")
    </div>
    
</body>

</html>

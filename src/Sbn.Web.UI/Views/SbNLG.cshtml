        @{
            var listIdOds = new List<String>();
            foreach (var goal in @Model.Ods){
                if (@goal.IndexOf("-") != -1){
                    listIdOds.Add(@goal.Split("-")[0]);
                }
            }
            
        }
           
 @{
                
            var x = 1;
            var classImg = "";
            
            <div class="panel-ods sdg">
            @for(var i = 0; i < 3; i++){
                <div class="row">
                    @for(var j = 0; j < 6; j++){
                        var y = "0" + x.ToString();
                        y = y.Substring(y.Length-2,2);
                        classImg = "class='abc'";
                        if (!listIdOds.Contains(x.ToString())){
                            classImg = "class=img-gray";
                        }
                        var src = "/media/assets/img/ods/s-web-goal-" + y + ".png";
                        <div class="col-md-2 p-2">
                            <img width="100%" height="100%" @classImg src="@src" alt="SDG icon" >
                        </div>
                        x++;
                        if (x==18) break;
                    }
                </div>
            }         
            </div>
        }
        
